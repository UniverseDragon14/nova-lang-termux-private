#!/data/data/com.termux/files/usr/bin/bash

ROOT="$HOME/nova-lang"
HIST="$ROOT/memory/history.txt"
TOOLS="$ROOT/tools"
APPS="$ROOT/apps"
STORE="$ROOT/store"

mkdir -p "$ROOT/memory" "$TOOLS" "$APPS" "$STORE"
touch "$HIST"

log_it() {
  echo "$(date '+%Y-%m-%d %H:%M:%S') | NOVATERM $1" >> "$HIST"
}

banner() {
  echo "=================================="
  echo " UNIVERSAL DRAGON - NOVA TERMINAL "
  echo " Creator: Aslam"
  echo " Version: NOVATERM v0.2"
  echo " Mode: Shortcut Tool-Language Console"
  echo "=================================="
}

help_menu() {
  echo "NOVATERM v0.2 Commands:"
  echo "  help"
  echo "  version"
  echo "  identity"
  echo "  ecosystem"
  echo "  where"
  echo "  clear"
  echo "  memory"
  echo "  history"
  echo "  status"
  echo "  backup"
  echo ""
  echo "Shortcuts:"
  echo "  tools"
  echo "  apps"
  echo "  store"
  echo "  run name"
  echo "  install name"
  echo "  publish name"
  echo "  code name"
  echo ""
  echo "Full:"
  echo "  tool create name"
  echo "  tool create name status"
  echo "  tool list"
  echo "  tool run name"
  echo "  store list"
  echo "  app run name"
  echo ""
  echo "  exit"
}

run_shortcut() {
  action="$1"
  name="$2"

  case "$action" in
    run)
      if [[ -f "$TOOLS/$name/main.nova" ]]; then
        novatool run "$name"
      elif [[ -f "$APPS/$name/main.nova" ]]; then
        nova app run "$name"
      else
        echo "No tool/app found: $name"
      fi
      ;;
    install)
      nova store install "$name"
      ;;
    publish)
      novatool publish "$name"
      ;;
    code)
      novatool code "$name"
      ;;
  esac
}

run_cmd() {
  raw="$1"
  set -- $raw

  case "$1" in
    help|"")
      help_menu
      ;;
    version)
      echo "NOVATERM v0.2"
      echo "NOVA language engine active"
      echo "NOVATOOL factory active"
      echo "NOVA Store registry active"
      ;;
    identity)
      nova identity
      ;;
    ecosystem)
      nova ecosystem
      ;;
    where)
      echo "ROOT: $ROOT"
      echo "TOOLS: $TOOLS"
      echo "APPS: $APPS"
      echo "STORE: $STORE"
      pwd
      ;;
    clear)
      clear
      banner
      ;;
    memory)
      nova show memory
      ;;
    history)
      nova history show
      ;;
    status)
      nova status
      ;;
    backup)
      nova backup
      ;;
    tools)
      novatool list
      ;;
    apps)
      nova app list
      ;;
    store)
      shift
      if [[ $# -eq 0 ]]; then
        nova store list
      else
        nova store "$@"
      fi
      ;;
    run|install|publish|code)
      run_shortcut "$1" "$2"
      ;;
    tool)
      shift
      novatool "$@"
      ;;
    app)
      shift
      nova app "$@"
      ;;
    exit)
      return 99
      ;;
    *)
      nova "$raw"
      ;;
  esac
}

banner
log_it "v0.2 started"

while true; do
  printf "dragon> "
  read -r cmd
  [[ "$cmd" == "exit" ]] && break
  run_cmd "$cmd"
done

log_it "v0.2 stopped"
echo "NOVATERM closed."
