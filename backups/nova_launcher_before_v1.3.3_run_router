#!/data/data/com.termux/files/usr/bin/bash

case "$1" in
  adapter)
    shift
    exec "$HOME/nova-lang/adapters/adapter_check.sh" "$@"
    ;;

  py)
    shift
    exec python -c "$*"
    ;;

  qbit|q)
    shift
    exec python "$HOME/nova-lang/adapters/qbit/qsim.py" "$@"
    ;;

  *)
    exec python "$HOME/nova-lang/nova.py" "$@"
    ;;
esac
