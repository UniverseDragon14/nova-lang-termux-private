#!/data/data/com.termux/files/usr/bin/bash

ROOT="$HOME/nova-lang"
MEM="$ROOT/memory/memory.txt"
HIST="$ROOT/memory/history.txt"
HASH="$ROOT/memory/state.sha256"
MODS="$ROOT/modules"
COURSE="$ROOT/course"
SPEC="$ROOT/NOVA_LANGUAGE_SPEC_v0.5.md"
ECO="$ROOT/UNIVERSAL_DRAGON_ECOSYSTEM.md"

mkdir -p "$ROOT/memory" "$ROOT/backups" "$ROOT/apps" "$MODS" "$COURSE"
touch "$MEM" "$HIST"

guard_update() {
  sha256sum "$MEM" "$HIST" > "$HASH"
}

guard_check() {
  if [[ -f "$HASH" ]]; then
    sha256sum -c "$HASH" >/dev/null 2>&1
    if [[ $? -ne 0 ]]; then
      echo "NOVA LOCK: memory/history changed outside NOVA."
      echo "Restore backup or approve repair manually."
      exit 1
    fi
  else
    guard_update
  fi
}

log_it() {
  echo "$(date '+%Y-%m-%d %H:%M:%S') | $1" >> "$HIST"
  guard_update
}

sanitize_intent() {
  raw="$1"
  if [[ "$raw" == *";"* || "$raw" == *"&"* || "$raw" == *"|"* || "$raw" == *"<"* || "$raw" == *">"* || "$raw" == *'$'* || "$raw" == *'`'* ]]; then
    echo "NOVA BLOCKED: illegal shell character found." >&2
    return 1
  fi
  printf "%s" "$raw"
  return 0
}

ask_yes() {
  echo
  read -r -p "NOVA approval required. Type YES: " ok < /dev/tty
  [ "$ok" = "YES" ]
}

safe_name() {
  [[ "$1" =~ ^[a-zA-Z0-9._-]+$ ]]
}

ensure_core_files() {
  if [[ ! -f "$SPEC" ]]; then
    cat > "$SPEC" <<'EOF'
# NOVA Language Specification v0.5

Universal Dragon = full ecosystem
NOVA = brain / language / intent engine
EVE = terminal / doctor / control layer
UDOS = mobile interface layer
Pi5 = live backend brain machine
Termux = first mobile host
GitHub = code / release / build home

## Core Flow
Human intent -> NOVA meaning -> safety check -> approval -> action -> memory

## File Extension
.nova

## Current Powers
- say message
- note message
- remember message
- show memory
- history show
- status
- backup
- install safe package
- create file
- create project
- module create
- module list
- module run
- ecosystem
- identity
EOF
  fi

  if [[ ! -f "$ECO" ]]; then
    cat > "$ECO" <<'EOF'
# Universal Dragon Ecosystem

Universal Dragon lives.
NOVA thinks.
EVE controls.
UDOS displays.
Pi5 runs.
GitHub stores/builds.
Cloudflare routes.
Aslam builds.

NOVA is not the whole ecosystem.
NOVA is one core brain/language part inside Universal Dragon.
EOF
  fi
}

install_pkg() {
  pkg="$1"
  case "$pkg" in
    git|nodejs|nano|curl|wget|openssh|clang|rust|openjdk-21)
      ;;
    python)
      echo "NOVA: Python blocked. Current mission is NOVA language first."
      return
      ;;
    *)
      echo "NOVA refused unknown package: $pkg"
      return
      ;;
  esac

  echo "NOVA wants to install: $pkg"
  if ask_yes; then
    pkg install -y "$pkg"
    log_it "installed $pkg"
  else
    echo "Cancelled."
    log_it "cancelled install $pkg"
  fi
}

run_file() {
  file="$1"
  [[ ! -f "$file" ]] && echo "File not found: $file" && return 1

  while IFS= read -r raw_line; do
    safe="$(sanitize_intent "$raw_line")" || continue
    run_line "$safe"
  done < "$file"
}

run_line() {
  line="$1"
  low="$(printf "%s" "$line" | tr '[:upper:]' '[:lower:]')"

  [[ -z "$line" || "$line" == \#* ]] && return

  if [[ "$low" == *"rm -rf"* || "$low" == *"mkfs"* || "$low" == *"format"* || "$low" == *"wipe"* || "$low" == *"dd if="* ]]; then
    echo "Blocked dangerous intent."
    log_it "blocked dangerous intent"
    return
  fi

  if [[ "$low" == "identity" || "$low" == "who are you" ]]; then
    echo "Universal Dragon = ecosystem"
    echo "NOVA = brain / language core"
    echo "EVE = terminal / doctor / control layer"
    echo "Aslam = creator / builder"
    return
  fi

  if [[ "$low" == "ecosystem" || "$low" == "show ecosystem" ]]; then
    cat "$ECO"
    return
  fi

  if [[ "$low" == "spec" || "$low" == "spec show" ]]; then
    cat "$SPEC"
    return
  fi

  if [[ "$line" =~ ^say[[:space:]]+(.+)$ ]]; then
    echo "${BASH_REMATCH[1]}"
    return
  fi

  if [[ "$line" =~ ^remember[[:space:]]+(.+)$ ]]; then
    msg="${BASH_REMATCH[1]}"
    echo "$msg" >> "$MEM"
    echo "Remembered."
    log_it "remembered: $msg"
    return
  fi

  if [[ "$line" =~ ^note[[:space:]]+(.+)$ ]]; then
    msg="${BASH_REMATCH[1]}"
    echo "$msg" >> "$MEM"
    echo "Noted."
    log_it "noted: $msg"
    return
  fi

  if [[ "$low" == "show memory" || "$low" == "memory show" || "$low" == *"memory kaatu"* ]]; then
    cat "$MEM"
    return
  fi

  if [[ "$low" == "history show" || "$low" == *"history kaatu"* ]]; then
    cat "$HIST"
    return
  fi

  if [[ "$low" == "status" || "$low" == "status system" || "$low" == *"system epdi"* ]]; then
    echo "NOVA System Status"
    uname -a
    pwd
    return
  fi

  if [[ "$low" == "backup" || "$low" == "backup project" || "$low" == *"backup pannu"* ]]; then
    name="$ROOT/backups/backup_$(date +%Y%m%d_%H%M%S).tar.gz"
    tar -czf "$name" "$ROOT" 2>/dev/null
    echo "Backup created: $name"
    log_it "backup created $name"
    return
  fi

  if [[ "$low" =~ ^install[[:space:]]+([a-zA-Z0-9._+-]+)$ ]]; then
    install_pkg "${BASH_REMATCH[1]}"
    return
  fi

  if [[ "$low" == *"git venum"* ]]; then install_pkg "git"; return; fi
  if [[ "$low" == *"node venum"* || "$low" == *"npm venum"* ]]; then install_pkg "nodejs"; return; fi
  if [[ "$low" == *"nano venum"* ]]; then install_pkg "nano"; return; fi
  if [[ "$low" == *"python venum"* ]]; then echo "NOVA: Python blocked. Build NOVA first."; return; fi

  if [[ "$low" =~ ^create[[:space:]]+file[[:space:]]+([a-zA-Z0-9._-]+)[[:space:]]+with[[:space:]]+(.+)$ ]]; then
    file="${BASH_REMATCH[1]}"
    content="${BASH_REMATCH[2]}"
    if safe_name "$file"; then
      echo "$content" > "$file"
      echo "File created: $file"
      log_it "file created $file"
    else
      echo "Blocked unsafe file name."
    fi
    return
  fi

  if [[ "$low" =~ ^create[[:space:]]+project[[:space:]]+([a-zA-Z0-9._-]+)$ ]]; then
    name="${BASH_REMATCH[1]}"
    mkdir -p "$ROOT/apps/$name"
    echo "say $name project created by NOVA" > "$ROOT/apps/$name/main.nova"
    echo "Project created: $ROOT/apps/$name"
    log_it "project created $name"
    return
  fi

  if [[ "$low" =~ ^module[[:space:]]+create[[:space:]]+([a-zA-Z0-9._-]+)$ ]]; then
    name="${BASH_REMATCH[1]}"
    mkdir -p "$MODS/$name"
    cat > "$MODS/$name/main.nova" <<EOF
say Module $name online
note Module $name created inside NOVA v0.5
EOF
    echo "Module created: $MODS/$name"
    log_it "module created $name"
    return
  fi

  if [[ "$low" == "module list" || "$low" == "modules" ]]; then
    ls -1 "$MODS" 2>/dev/null || echo "No modules yet."
    return
  fi

  if [[ "$low" =~ ^module[[:space:]]+run[[:space:]]+([a-zA-Z0-9._-]+)$ ]]; then
    name="${BASH_REMATCH[1]}"
    run_file "$MODS/$name/main.nova"
    log_it "module ran $name"
    return
  fi

  if [[ "$low" == "course create" || "$low" == "nova course create" ]]; then
    cat > "$COURSE/NOVA_COURSE_v0.1.md" <<'EOF'
# NOVA Course v0.1

## Lesson 1
Universal Dragon = ecosystem.
NOVA = brain/language core.

## Lesson 2
A .nova file contains human-readable intent.

## Lesson 3
NOVA checks safety before action.

## Lesson 4
Important actions require approval.

## Lesson 5
NOVA remembers through memory and history.
EOF
    echo "Course created: $COURSE/NOVA_COURSE_v0.1.md"
    log_it "course created"
    return
  fi

  if [[ "$low" == "list files" || "$low" == "files kaatu" ]]; then
    ls -la
    return
  fi

  if [[ "$low" == "help" || "$low" == "nova help" ]]; then
    echo "NOVA v0.5 Commands:"
    echo "  nova identity"
    echo "  nova ecosystem"
    echo "  nova spec"
    echo "  nova shell"
    echo "  nova show memory"
    echo "  nova history show"
    echo "  nova status"
    echo "  nova note message"
    echo "  nova install git"
    echo "  nova create file a.txt with hello"
    echo "  nova create project dragon"
    echo "  nova module create memory-core"
    echo "  nova module list"
    echo "  nova module run memory-core"
    echo "  nova course create"
    echo "  nova backup"
    return
  fi

  echo "NOVA does not understand: $line"
}

ensure_core_files
guard_check

if [[ "$1" == "shell" ]]; then
  echo "NOVA Shell v0.5. Type exit to leave."
  while true; do
    read -r -p "nova> " raw < /dev/tty
    [[ "$raw" == "exit" ]] && break
    safe="$(sanitize_intent "$raw")" || continue
    run_line "$safe"
  done
  exit 0
fi

if [[ "$1" == "run" ]]; then
  run_file "$2"
  exit 0
fi

if [[ -f "$1" ]]; then
  run_file "$1"
  exit 0
fi

if [[ $# -gt 0 ]]; then
  safe="$(sanitize_intent "$*")" || exit 1
  run_line "$safe"
  exit 0
fi

echo "NOVA Language v0.5"
echo "Use: nova help"
