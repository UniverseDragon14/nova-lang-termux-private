#!/data/data/com.termux/files/usr/bin/bash

ROOT="$HOME/nova-lang"
TOOLS="$ROOT/tools"
HIST="$ROOT/memory/history.txt"
mkdir -p "$TOOLS" "$ROOT/memory"
touch "$HIST"

log_it() {
  echo "$(date '+%Y-%m-%d %H:%M:%S') | NOVATOOL $1" >> "$HIST"
}

safe_name() {
  [[ "$1" =~ ^[a-zA-Z0-9._-]+$ ]]
}

help_menu() {
  echo "NOVA Tool Factory v0.1"
  echo "Commands:"
  echo "  novatool create backup-tool"
  echo "  novatool list"
  echo "  novatool info backup-tool"
  echo "  novatool run backup-tool"
  echo "  novatool pack backup-tool"
}

create_tool() {
  name="$1"
  safe_name "$name" || { echo "Bad tool name."; exit 1; }

  dir="$TOOLS/$name"
  mkdir -p "$dir"

  cat > "$dir/main.nova" <<EOF
say Tool $name online
note Tool $name executed through NOVA Tool Factory
EOF

  cat > "$dir/ABOUT.txt" <<EOF
Tool: $name
Type: NOVA tool
Runtime: nova run main.nova
Status: created
EOF

  echo "Tool created: $dir"
  log_it "created tool $name"
}

list_tools() {
  ls -1 "$TOOLS" 2>/dev/null || echo "No tools yet."
}

info_tool() {
  name="$1"
  cat "$TOOLS/$name/ABOUT.txt" 2>/dev/null || echo "Tool not found: $name"
}

run_tool() {
  name="$1"
  file="$TOOLS/$name/main.nova"
  [[ ! -f "$file" ]] && echo "Tool not found: $name" && exit 1
  nova run "$file"
  log_it "ran tool $name"
}

pack_tool() {
  name="$1"
  dir="$TOOLS/$name"
  [[ ! -d "$dir" ]] && echo "Tool not found: $name" && exit 1

  out="$ROOT/backups/tool_${name}_$(date +%Y%m%d_%H%M%S).tar.gz"
  tar -czf "$out" -C "$TOOLS" "$name" 2>/dev/null

  echo "Tool package created: $out"
  log_it "packed tool $name"
}

case "$1" in
  create) create_tool "$2" ;;
  list) list_tools ;;
  info) info_tool "$2" ;;
  run) run_tool "$2" ;;
  pack) pack_tool "$2" ;;
  help|"") help_menu ;;
  *) echo "Unknown novatool command."; help_menu ;;
esac
