#!/data/data/com.termux/files/usr/bin/bash

ROOT="$HOME/nova-lang"
TOOLS="$ROOT/tools"
STORE="$ROOT/store"
HIST="$ROOT/memory/history.txt"

mkdir -p "$TOOLS" "$STORE" "$ROOT/memory" "$ROOT/backups"
touch "$HIST"

log_it() {
  echo "$(date '+%Y-%m-%d %H:%M:%S') | NOVATOOL $1" >> "$HIST"
}

safe_name() {
  [[ "$1" =~ ^[a-zA-Z0-9._-]+$ ]]
}

help_menu() {
  echo "NOVATOOL v0.2 - Tool Grammar"
  echo "Commands:"
  echo "  novatool create mytool"
  echo "  novatool create status-tool status"
  echo "  novatool create note-tool note"
  echo "  novatool create file-tool file"
  echo "  novatool list"
  echo "  novatool info mytool"
  echo "  novatool code mytool"
  echo "  novatool run mytool"
  echo "  novatool pack mytool"
  echo "  novatool publish mytool"
}

create_tool() {
  name="$1"
  kind="${2:-basic}"

  safe_name "$name" || { echo "Bad tool name."; exit 1; }

  dir="$TOOLS/$name"
  mkdir -p "$dir"

  case "$kind" in
    basic)
      cat > "$dir/main.nova" <<EOF
say Tool $name online
note Tool $name executed
EOF
      ;;
    status)
      cat > "$dir/main.nova" <<EOF
say Tool $name online
status
note Status tool $name executed
EOF
      ;;
    note)
      cat > "$dir/main.nova" <<EOF
say Tool $name online
note Note tool $name saved a message
show memory
EOF
      ;;
    file)
      cat > "$dir/main.nova" <<EOF
say Tool $name online
create file ${name}_output.txt with created_by_$name
note File tool $name created output file
EOF
      ;;
    *)
      echo "Unknown tool type. Use: basic / status / note / file"
      exit 1
      ;;
  esac

  cat > "$dir/ABOUT.txt" <<EOF
Tool: $name
Type: $kind
Runtime: nova run main.nova
Created by: NOVATOOL v0.2
Meaning: Universal Dragon tool-language module
EOF

  echo "Tool created: $dir"
  log_it "created tool $name type=$kind"
}

list_tools() {
  ls -1 "$TOOLS" 2>/dev/null || echo "No tools yet."
}

info_tool() {
  name="$1"
  cat "$TOOLS/$name/ABOUT.txt" 2>/dev/null || echo "Tool not found: $name"
}

code_tool() {
  name="$1"
  cat "$TOOLS/$name/main.nova" 2>/dev/null || echo "Tool code not found: $name"
}

run_tool() {
  name="$1"
  file="$TOOLS/$name/main.nova"
  [[ ! -f "$file" ]] && echo "Tool not found: $name" && exit 1
  nova run "$file"
  log_it "ran tool $name"
}

pack_tool() {
  name="$1"
  dir="$TOOLS/$name"
  [[ ! -d "$dir" ]] && echo "Tool not found: $name" && exit 1

  out="$ROOT/backups/tool_${name}_$(date +%Y%m%d_%H%M%S).tar.gz"
  tar -czf "$out" -C "$TOOLS" "$name" 2>/dev/null

  echo "Tool package created: $out"
  log_it "packed tool $name"
}

publish_tool() {
  name="$1"
  dir="$TOOLS/$name"
  [[ ! -d "$dir" ]] && echo "Tool not found: $name" && exit 1

  mkdir -p "$STORE/$name"
  cp "$dir/main.nova" "$STORE/$name/app.nova"
  cp "$dir/ABOUT.txt" "$STORE/$name/ABOUT.txt"

  echo "Tool published to NOVA Store: $name"
  log_it "published tool $name to store"
}

case "$1" in
  create) create_tool "$2" "$3" ;;
  list) list_tools ;;
  info) info_tool "$2" ;;
  code) code_tool "$2" ;;
  run) run_tool "$2" ;;
  pack) pack_tool "$2" ;;
  publish) publish_tool "$2" ;;
  help|"") help_menu ;;
  *) echo "Unknown novatool command."; help_menu ;;
esac
