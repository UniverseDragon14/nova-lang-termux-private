#!/data/data/com.termux/files/usr/bin/bash

ROOT="$HOME/nova-lang"
HIST="$ROOT/memory/history.txt"
mkdir -p "$ROOT/memory"
touch "$HIST"

log_it() {
  echo "$(date '+%Y-%m-%d %H:%M:%S') | NOVATERM $1" >> "$HIST"
}

banner() {
  echo "=================================="
  echo " UNIVERSAL DRAGON - NOVA TERMINAL "
  echo " Creator: Aslam"
  echo " Mode: Tool-Language Console"
  echo "=================================="
}

help_menu() {
  echo "NOVATERM Commands:"
  echo "  help"
  echo "  identity"
  echo "  ecosystem"
  echo "  memory"
  echo "  history"
  echo "  status"
  echo "  backup"
  echo ""
  echo "Tool:"
  echo "  tool create name"
  echo "  tool create name status"
  echo "  tool list"
  echo "  tool code name"
  echo "  tool run name"
  echo "  tool publish name"
  echo ""
  echo "Store/App:"
  echo "  store init"
  echo "  store list"
  echo "  store info name"
  echo "  store install name"
  echo "  app list"
  echo "  app run name"
  echo ""
  echo "  exit"
}

run_cmd() {
  raw="$1"
  set -- $raw

  case "$1" in
    help|"")
      help_menu
      ;;
    identity)
      nova identity
      ;;
    ecosystem)
      nova ecosystem
      ;;
    memory)
      nova show memory
      ;;
    history)
      nova history show
      ;;
    status)
      nova status
      ;;
    backup)
      nova backup
      ;;
    tool)
      shift
      novatool "$@"
      ;;
    store)
      shift
      nova store "$@"
      ;;
    app)
      shift
      nova app "$@"
      ;;
    exit)
      return 99
      ;;
    *)
      nova "$raw"
      ;;
  esac
}

banner
log_it "started"

while true; do
  printf "dragon> "
  read -r cmd
  [[ "$cmd" == "exit" ]] && break
  run_cmd "$cmd"
done

log_it "stopped"
echo "NOVATERM closed."
